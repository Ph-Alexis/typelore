{
  "name": "@typelore/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p tsconfig.test.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@typelore/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsx": "^4.23.15"
  }
}
